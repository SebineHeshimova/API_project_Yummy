@model UpdateContactDTO
@{
    ViewData["Title"] = "UpdateContact";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>About update page</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group row">
                                <input type="hidden" asp-for="ContactId"/>
                                <label for="inputPassword" class="col-sm-2 col-form-label">Phone</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="Phone" class="form-control" placeholder="Phone">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">Email</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="Email" class="form-control" placeholder="Email">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">Address</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="Address" class="form-control" placeholder="Address">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">MapLocation</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="MapLocation" class="form-control" placeholder="MapLocation">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">OpenHours</label>
                                <div class="col-sm-10">
                                    <input type="time" asp-for="OpenHours" class="form-control" placeholder=OpenHours">
                                    <br />
                                    <button class="btn btn-primary">Update</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

