@model UpdateServiceDTO
@{
    ViewData["Title"] = "UpdateService";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Service update page</h4>
                    </div>
                    <div class="card-body">

                        <form method="post">
                            <div class="form-group row">
                                <input type="hidden" asp-for="ServiceId" />
                                <label for="inputPassword" class="col-sm-2 col-form-label">Title</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="Title" class="form-control" placeholder="Title">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">Description</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="Description" class="form-control" placeholder="Description">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">IconUrl</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="IconUrl" class="form-control" placeholder="IconUrl">
                                    <br />
                                    <button class="btn btn-primary">Update</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

