@model UpdateAboutDTO
@{
    ViewData["Title"] = "UpdateAbout";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Category update page</h4>
                    </div>
                    <div class="card-body">

                        <form method="post">
                            <div class="form-group row">
                                <input type="hidden" asp-for="AboutId" />
                                <label for="inputPassword" class="col-sm-2 col-form-label">Title</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="Title" class="form-control" placeholder="Title">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">Description</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="Description" class="form-control" placeholder="Description">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">Reservation Number</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="ReservationNumber" class="form-control" placeholder="Reservation Number">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">ImageUrl</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="ImageUrl" class="form-control" placeholder="ImageUrl">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">VideoCover</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="VideoCover" class="form-control" placeholder=VideoCover">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">VideoUrl</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="VideoUrl" class="form-control" placeholder=VideoUrl">
                                    <br />
                                    <button class="btn btn-primary">Update</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
