@model UpdateFeedbackDTO
@{
    ViewData["Title"] = "UpdateFeedback";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12 col-md-12 col-lg-12">
                <div class="card">
                    <div class="card-header">
                        <h4>Feedback update page</h4>
                    </div>
                    <div class="card-body">
                        <form method="post">
                            <div class="form-group row">
                                <input type="hidden" asp-for="FeedbackId" />
                                <label for="inputPassword" class="col-sm-2 col-form-label">Name and Surname</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="NameSurname" class="form-control" placeholder="NameSurname">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">Title</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="Title" class="form-control" placeholder="Title">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">Comment</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="Comment" class="form-control" placeholder="Comment">
                                    <br />
                                </div>
                                <label for="inputPassword" class="col-sm-2 col-form-label">ImageUrl</label>
                                <div class="col-sm-10">
                                    <input type="text" asp-for="ImageUrl" class="form-control" placeholder="ImageUrl">
                                    <br />
                                    <button class="btn btn-primary">Update</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

